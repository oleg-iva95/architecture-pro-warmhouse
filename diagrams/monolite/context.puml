@startuml
title Диаграмма контекста системы «Умный Дом»

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Person(user, "Пользователь", "Пользователь который использует систему")
System(smarthome, "Умный Дом", "Система управления отоплением")

System_Ext(DataBase, "База данных\nPostgres", "Хранит информацию и конфигурацию")
System_Ext(IOT, "IoT - девайсы", "Получение информации о температуре")
Rel(user, smarthome, "HTTP API (Sync,JSON) \n [Запрашивает информацию]")
Rel(smarthome,DataBase,"SQL")
Rel(smarthome,IOT,"HTTP")

@enduml
